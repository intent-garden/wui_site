{
  "name": "WUI (Window User Interface Library)",
  "description": "C++17 GUI library with shared controls, themes, localization and event callbacks",
  "homepage": "https://libwui.org",
  "repository": "https://github.com/intent-garden/wui",
  "documentation": {"en": "https://libwui.org/doc/", "ru": "https://libwui.org/doc_ru/"},
  "language": "C++17",
  "license": "BSL-1.0",
  "header_only": false,
  "official_boost_library": false,
  "platforms": {
    "windows": {"backend": "WinAPI, GDI/GDI+"},
    "linux": {"backend": "X11/XCB, Cairo"},
    "macos": {"status": "experimental", "backend": "AppKit, CoreGraphics"},
    "wasm": {"status": "experimental", "backend": "Emscripten, Canvas 2D, DOM events"}
  },
  "examples": ["https://libwui.org/wasm/demo/", "https://libwui.org/wasm/simple/", "https://libwui.org/wasm/hello_world/"],
  "build_guides": "https://github.com/intent-garden/wui/tree/main/doc/en/docs/howto"
}
